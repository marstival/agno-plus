# ── Required ─────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Database (matches docker-compose.yml defaults) ─────────────────────────
DATABASE_URL=postgresql://aide:aide@localhost:5432/aide

# ── LLM / Embeddings ─────────────────────────────────────────────────────────
LLM_BACKEND=openai          # openai | ollama
LLM_MODEL=gpt-4o-mini
EMBED_MODEL=text-embedding-3-small

# ── Local-only alternative: Ollama ────────────────────────────────────────
# LLM_BACKEND=ollama
# LLM_MODEL=llama3.2
# OLLAMA_URL=http://host.docker.internal:11434

# ── File storage ─────────────────────────────────────────────────────────────
UPLOADS_DIR=./uploads

# ── Langfuse observability (optional) ────────────────────────────────────────
# Run: docker compose -f docker-compose.yml -f docker-compose.langfuse.yml up -d
# Then set the keys from docker-compose.langfuse.yml:
# LANGFUSE_HOST=http://localhost:3001
# LANGFUSE_PUBLIC_KEY=lf-pk-aide-local-public-key
# LANGFUSE_SECRET_KEY=lf-sk-aide-local-secret-key
