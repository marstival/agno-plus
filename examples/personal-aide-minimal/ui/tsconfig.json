{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "paths": {
      "@agno-plus/ui": ["../../../ui/src/index.ts"],
      "@agno-plus/ui/*": ["../../../ui/src/*"]
    }
  },
  "include": ["src", "../../../ui/src"],
  "exclude": ["../../../ui/src/**/*.test.*"]
}
